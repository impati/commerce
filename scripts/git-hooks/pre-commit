#!/bin/sh
# 커밋 전에 도커 없이 도는 테스트를 돌린다.
#
# 컨테이너가 필요한 것(@RequiresDatabase)은 뺀다. 전체는 작업이 끝나는 시점에 `make verify`가
# 돌며, 그 실행은 CLAUDE.md의 작업 흐름과 rca-code-review가 강제한다 — 커밋마다 MySQL을
# 띄우게 하면 커밋이 비싸지고, 비싼 게이트는 --no-verify로 우회된다 (ADR-0013).
#
# 이 훅은 `git config core.hooksPath scripts/git-hooks`가 설정돼 있어야 동작한다.
# 새로 clone했으면 `make setup-hooks`를 한 번 실행할 것.
set -e

echo "pre-commit: ./gradlew test -PexcludeTags=infra"
exec ./gradlew test -PexcludeTags=infra
